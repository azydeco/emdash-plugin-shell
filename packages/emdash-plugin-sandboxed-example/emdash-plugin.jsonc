{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "emdash-plugin-sandboxed-example",
	"publisher": "did:plc:nfm27pwymsd5ntjlsaz3ivli",

	"name": "Sandboxed Plugin Example",
	"description": "An example sandboxed plugin for EmDash to be used or referred to when developing a new plugin",
	"keywords": ["sandboxed", "azydeco", "example", "testing"],
	"sections": {
		"description": { "file": "listing/description.md" },
	},
	"license": "MIT",
	"author": { "name": "Azydeco Software Ltd", "url": "https://azydeco.com" },
	"security": { "email": "tellmemore@azydeco.com" },
	"repo": "https://github.com/azydeco/emdash-plugin-shell",

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": [],
	"allowedHosts": [],
	"storage": {},
	"release": {
		"artifacts": {
			"icon": { "file": "icon.png" },
		},
	},
	"admin": {
		"pages": [
			{
				"path": "/settings",
				"label": "Sandboxed Example",
				"icon": "image",
			},
		],
	},
}
