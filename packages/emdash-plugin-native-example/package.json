{
	"name": "@azydeco/emdash-plugin-native-example",
	"version": "0.1.0",
	"description": "An example native plugin for EmDash to be used or referred to when developing a new plugin",
	"keywords": [
		"emdash",
		"emdash-plugin"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/azydeco/emdash-plugin-shell.git",
		"directory": "packages/emdash-plugin-native-example"
	},
	"files": [
		"src"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "catalog:",
		"emdash": "catalog:",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0"
	},
	"peerDependencies": {
		"emdash": "catalog:"
	}
}
